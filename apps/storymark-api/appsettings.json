{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=storymark;Username=storymark;Password=storymark"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Storymark": {
    "DebugEndpointsEnabled": false
  },
  "Storage": {
    "RootPath": "/data"
  },
  "Auth": {
    "BearerTokenSeed": ""
  },
  "Settings": {
    "EncryptionKey": ""
  },
  "SettingsDefaults": {
    "UploadMaxBytes": 209715200,
    "RecapCardOnSectionEntry": true,
    "Search": {
      "Synonyms": {
        "jail": ["jail", "prison", "imprisoned", "arrested", "accused", "sentenced", "constable", "guard", "locked up", "dungeon"],
        "death": ["died", "killed", "murdered", "slain", "executed", "passed away"],
        "relationship": ["father", "mother", "brother", "sister", "friend", "enemy", "lover", "married", "betrayed"],
        "travel": ["left", "arrived", "journeyed", "escaped", "fled", "returned"]
      }
    },
    "Assistant": {
      "TrimLocal": true,
      "MaxChunks": 12,
      "MaxChunksLocal": 6
    }
  },
  "AllowedHosts": "*"
}
