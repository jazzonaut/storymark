<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Clears any machine/user-level feeds so restores are reproducible on every
       host and in CI. Storymark depends only on public packages from nuget.org. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
