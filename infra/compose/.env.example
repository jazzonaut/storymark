# Storymark — example .env. Copy to `.env` and fill in real values.
# Never commit `.env` (it's already in .gitignore).

# --- Required ---------------------------------------------------------------

# Strong random password for the Storymark Postgres role.
POSTGRES_PASSWORD=change-me-strong-random

# Initial password for the seeded admin account. Applied on startup only while
# the account has no password, then inert — change it in-app afterwards.
STORYMARK_BOOTSTRAP_PASSWORD=change-me-strong-password

# Base64-encoded 32-byte key used to encrypt secret settings at rest.
# Generate with: openssl rand -base64 32
STORYMARK_SETTINGS_ENCRYPTION_KEY=change-me-base64-32-bytes

# Exposes the internal /api/_debug/* endpoints. Keep false in production.
STORYMARK_DEBUG_ENDPOINTS=false

# --- Image / tag ------------------------------------------------------------

# Full image reference, no tag. For local builds leave at the default.
# Examples:
#   STORYMARK_API_IMAGE=registry.example.com/your-org/storymark-api
#   STORYMARK_API_IMAGE=ghcr.io/your-org/storymark-api
STORYMARK_API_IMAGE=storymark-api

# Image tag. Pin to a commit SHA to roll back.
STORYMARK_API_TAG=latest

# --- Data location (docker-compose.caddy.yml only) --------------------------

# Host directory for the Postgres data + book-file bind mounts, when deploying
# the caddy production file (docker-compose.caddy.yml). Postgres lands in
# $STORYMARK_DATA_ROOT/postgres and books in $STORYMARK_DATA_ROOT/data. The
# Ollama model cache is deliberately a Docker named volume (re-pullable, kept
# out of host-path backups), not under this root. Unused by the base file,
# which uses named volumes for everything.
# STORYMARK_DATA_ROOT=/opt/docker/storymark

# --- Ingress ----------------------------------------------------------------

# Public URL the SPA is served from. Used by service worker scope + deep links.
STORYMARK_PUBLIC_URL=https://storymark.example.com

# Host port to publish the API on, e.g. "8088" or "127.0.0.1:8088".
# Leave empty (or set to "127.0.0.1:8088") if a reverse proxy on a shared
# Docker network handles ingress.
STORYMARK_API_PUBLISHED_PORT=127.0.0.1:8088

# Shared-network reverse proxy (caddy-docker-proxy / Traefik). Only consumed by
# the docker-compose.proxy.yml overlay — see docs/deployment/03-reverse-proxy-options.md.
# Leave unset for the standalone base stack (front it via STORYMARK_API_PUBLISHED_PORT
# above, or a host-level proxy to that port).
# STORYMARK_PROXY_NETWORK=caddy

# Public host(s) for the proxy overlay's routing label (no scheme), e.g.
# storymark.example.com.
# STORYMARK_PUBLIC_HOSTS=storymark.example.com

# --- Ollama -----------------------------------------------------------------

# Publish Ollama on the host (uncomment for debugging or external clients).
# OLLAMA_PUBLISHED_PORT=127.0.0.1:11434
